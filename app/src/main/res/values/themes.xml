<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VacuumTube" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/vt_background</item>
        <item name="android:statusBarColor">@color/vt_background_dark</item>
        <item name="android:navigationBarColor">@color/vt_background_dark</item>
        <item name="colorPrimary">@color/vt_accent</item>
        <item name="colorPrimaryVariant">@color/vt_accent</item>
        <item name="colorSecondary">@color/vt_accent_red</item>
        <item name="colorSurface">@color/vt_surface</item>
        <item name="android:textColorPrimary">@color/vt_text_primary</item>
        <item name="android:textColorSecondary">@color/vt_text_secondary</item>
        <item name="android:windowBackground">@color/vt_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.VacuumTube.Settings" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/vt_background</item>
        <item name="android:statusBarColor">@color/vt_background_dark</item>
        <item name="android:navigationBarColor">@color/vt_background_dark</item>
        <item name="colorPrimary">@color/vt_accent</item>
        <item name="android:textColorPrimary">@color/vt_text_primary</item>
        <item name="android:windowBackground">@color/vt_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="SettingsSectionTitle" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textColor">@color/vt_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="SettingsRowTitle" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@color/vt_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsRowDesc" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/vt_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>